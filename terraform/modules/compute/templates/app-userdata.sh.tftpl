#!/bin/bash
# App VM bootstrap: NAT hop, WireGuard endpoint, and K3s.
# Terraform interpolates $${...} before bash sees this file, so $VAR and $(...)
# survive into the written scripts untouched.
set -euo pipefail
exec >> /var/log/lab-bootstrap.log 2>&1
echo "=== app bootstrap $(date -Is) ==="

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y wireguard

snap install aws-cli --classic >/dev/null 2>&1 || true

TOKEN="$(curl -sX PUT http://169.254.169.254/latest/api/token \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
PRIV_IP="$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/local-ipv4)"
echo "private address: $PRIV_IP"

# --------------------------------------------------------------------------
# Forwarding and NAT
# --------------------------------------------------------------------------

cat > /etc/sysctl.d/99-lab-nat.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
SYSCTL
sysctl --system

# Re-applied at every boot by systemd rather than written once by cloud-init,
# so a reboot cannot quietly blackhole the private subnet. Every rule is
# checked before being added, making the script safe to re-run.
cat > /usr/local/sbin/lab-nat.sh <<'NAT'
#!/bin/bash
set -euo pipefail
IFACE="$(ip -o -4 route show to default | awk '{print $5}' | head -n1)"

for CIDR in ${nat_cidrs}; do
  iptables -t nat -C POSTROUTING -s "$CIDR" -o "$IFACE" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s "$CIDR" -o "$IFACE" -j MASQUERADE
  iptables -C FORWARD -s "$CIDR" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -s "$CIDR" -j ACCEPT
  iptables -C FORWARD -d "$CIDR" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD 1 -d "$CIDR" -j ACCEPT
done
NAT
chmod 0755 /usr/local/sbin/lab-nat.sh

cat > /etc/systemd/system/lab-nat.service <<'UNIT'
[Unit]
Description=NAT for the lab private subnet and VPN pool
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lab-nat.sh

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now lab-nat.service

# --------------------------------------------------------------------------
# WireGuard
#
# Keys are generated here and never handed to Terraform, so no private key
# reaches state. They are also mirrored to Parameter Store and restored on
# boot: without that, every change to this script replaces the instance,
# rotates the keys, and silently kills every peer config already handed out.
# --------------------------------------------------------------------------

umask 077
mkdir -p /etc/wireguard/keys
cd /etc/wireguard

# Restore a key from Parameter Store, or mint and publish one. Idempotent.
wg_key() {
  local name="$1"
  local file="keys/$name.key"
  [ -s "$file" ] && return 0

  if aws ssm get-parameter --region ${region} \
       --name "${ssm_prefix}/wireguard/keys/$name" --with-decryption \
       --query Parameter.Value --output text > "$file" 2>/dev/null && [ -s "$file" ]; then
    echo "restored wireguard key: $name"
  else
    wg genkey > "$file"
    aws ssm put-parameter --region ${region} \
      --name "${ssm_prefix}/wireguard/keys/$name" --type SecureString \
      --overwrite --value "$(cat "$file")" >/dev/null
    echo "generated wireguard key: $name"
  fi
  chmod 600 "$file"
}

wg_key server
wg pubkey < keys/server.key > keys/server.pub

SERVER_PRIV="$(cat keys/server.key)"
SERVER_PUB="$(cat keys/server.pub)"
WG_NET="${wg_client_cidr}"
WG_BASE="$(echo "$WG_NET" | cut -d/ -f1 | cut -d. -f1-3)"

cat > /etc/wireguard/wg0.conf <<CONF
# Managed by cloud-init. Edits are lost when the instance is replaced.
[Interface]
Address = $WG_BASE.1/24
ListenPort = ${wg_listen_port}
PrivateKey = $SERVER_PRIV
CONF

for i in $(seq 1 ${wg_peer_count}); do
  wg_key "client$i"
  wg pubkey < "keys/client$i.key" > "keys/client$i.pub"
  CLIENT_IP="$WG_BASE.$((i + 1))"

  cat >> /etc/wireguard/wg0.conf <<PEER

[Peer]
PublicKey = $(cat "keys/client$i.pub")
AllowedIPs = $CLIENT_IP/32
PEER

  # Split tunnel: only the VPC and the VPN pool cross the tunnel, so a peer's
  # ordinary internet traffic is neither routed through nor visible here.
  CLIENT_CONF="$(cat <<CCONF
[Interface]
PrivateKey = $(cat "keys/client$i.key")
Address = $CLIENT_IP/32

[Peer]
PublicKey = $SERVER_PUB
Endpoint = ${wg_endpoint}:${wg_listen_port}
AllowedIPs = ${vpc_cidr}, $WG_NET
PersistentKeepalive = 25
CCONF
)"

  aws ssm put-parameter --region ${region} \
    --name "${ssm_prefix}/wireguard/client-$i" --type SecureString \
    --overwrite --value "$CLIENT_CONF" >/dev/null
  echo "published ${ssm_prefix}/wireguard/client-$i"
done

chmod 600 /etc/wireguard/wg0.conf
systemctl enable --now "wg-quick@wg0"

# --------------------------------------------------------------------------
# K3s
#
# Traefik is disabled because ingress-nginx is what carries ModSecurity, and
# running two ingress controllers would leave a path around the WAF.
# --------------------------------------------------------------------------

if ! command -v k3s >/dev/null 2>&1; then
  curl -sfL https://get.k3s.io \
    | INSTALL_K3S_VERSION="${k3s_version}" \
      INSTALL_K3S_EXEC="server --disable traefik --write-kubeconfig-mode 0600 --tls-san $PRIV_IP --tls-san $WG_BASE.1" \
      sh -
fi

systemctl enable --now k3s

# Readiness, not just "the service started".
for _ in $(seq 1 60); do
  k3s kubectl get node 2>/dev/null | grep -q ' Ready' && break
  sleep 5
done
k3s kubectl get node

# Published so an operator on the VPN can talk to the API without copying
# files off the box by hand. The server URL is rewritten from 127.0.0.1,
# which is useless anywhere but the node itself.
sed "s#https://127.0.0.1:6443#https://$PRIV_IP:6443#" /etc/rancher/k3s/k3s.yaml \
  > /tmp/kubeconfig.pub
aws ssm put-parameter --region ${region} \
  --name "${ssm_prefix}/k3s/kubeconfig" --type SecureString \
  --tier Intelligent-Tiering --overwrite --value "file:///tmp/kubeconfig.pub" >/dev/null
rm -f /tmp/kubeconfig.pub
echo "published ${ssm_prefix}/k3s/kubeconfig"

# --------------------------------------------------------------------------
# Wazuh agent
#
# Collects the WAF's logs so ModSecurity decisions and the verifier's marker
# reach the indexer. The manager address is a constant, not looked up: the
# Wazuh instance depends on the NAT route which depends on this instance, so
# referencing it here would close a cycle in the Terraform graph.
# --------------------------------------------------------------------------

WAZUH_MANAGER_IP="${wazuh_manager}"

if [ ! -x /var/ossec/bin/wazuh-control ]; then
  curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH \
    | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
  chmod 644 /usr/share/keyrings/wazuh.gpg
  echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" \
    > /etc/apt/sources.list.d/wazuh.list
  apt-get update -y
  # WAZUH_MANAGER is read by the package's postinst, which writes it into
  # ossec.conf, so the agent knows where to enrol without a second edit.
  WAZUH_MANAGER="$WAZUH_MANAGER_IP" apt-get install -y "wazuh-agent=${wazuh_agent_version}-1"
  # The agent is deliberately excluded from unattended upgrades; a version
  # bump mid-assessment would restart collection at an arbitrary moment.
  apt-mark hold wazuh-agent
fi

# Enrolment is password-protected. The manager mints the password and both
# sides read it from Parameter Store, so it is never written in this file.
for _ in $(seq 1 60); do
  if ENROLL_PW="$(aws ssm get-parameter --region ${region} \
        --name "${ssm_prefix}/wazuh/enrollment-password" --with-decryption \
        --query Parameter.Value --output text 2>/dev/null)" \
     && [ -n "$ENROLL_PW" ] && [ "$ENROLL_PW" != "None" ]; then
    break
  fi
  echo "waiting for the manager to publish the enrolment password"
  sleep 10
done

if [ -n "$${ENROLL_PW:-}" ] && [ "$ENROLL_PW" != "None" ]; then
  printf '%s' "$ENROLL_PW" > /var/ossec/etc/authd.pass
  chmod 640 /var/ossec/etc/authd.pass
  chown root:wazuh /var/ossec/etc/authd.pass
fi

# Collect the WAF container's stdout. K3s writes it under /var/log/containers
# as CRI-format lines, so it is read as plain text and matched on content
# rather than parsed as JSON. Both the nginx access log and the ModSecurity
# JSON audit record arrive on this one stream.
python3 - <<'OSSEC'
import pathlib, re
p = pathlib.Path("/var/ossec/etc/ossec.conf")
t = p.read_text()
block = """
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/containers/waf-*lab*.log</location>
  </localfile>
"""
if "/var/log/containers/waf-" not in t:
    # Append inside the final ossec_config element.
    i = t.rfind("</ossec_config>")
    t = t[:i] + block + t[i:]
    p.write_text(t)
    print("added WAF log collection to ossec.conf")
else:
    print("WAF log collection already configured")
OSSEC

# Do not start until the manager is actually listening, otherwise the first
# enrolment attempt fails and the agent sits in a back-off.
for _ in $(seq 1 60); do
  (echo > /dev/tcp/$WAZUH_MANAGER_IP/1515) >/dev/null 2>&1 && break
  sleep 10
done

systemctl daemon-reload
systemctl enable wazuh-agent
systemctl restart wazuh-agent
sleep 5
/var/ossec/bin/wazuh-control status | head -5

echo "=== app bootstrap complete $(date -Is) ==="
